# Source from an isolated experiment checkout. Never install serving into .venv.
_jb_ops_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export JB_EXPERIMENT_PYTHON=/storage/ice1/8/3/pablo3/llmge-redsea/.venv/bin/python
export JB_SERVING_ENV=/storage/ice1/8/3/pablo3/vllm-0.17-py312-f88321e
export JB_VLLM_BIN="$JB_SERVING_ENV/bin/vllm"
export JB_CUDA_MODULE=cuda/12.9.1
export JB_SHARED_MODEL_ROOT=/storage/ice1/8/3/pablo3/pr3-models
export UV_NO_SYNC=1 UV_OFFLINE=1
export JB_SELECTION=map_elites JB_JUDGE_MODE=llm JB_JUDGE_PROMPT=rubric
export JB_BALANCE_TURN_DEPTHS=1 JB_STRUCTURAL_TURN_DEPTH_MUTATION=1
export LLMGE_START_POPULATION_SIZE=24 LLMGE_POPULATION_SIZE=24 LLMGE_NUM_GENERATIONS=17
export JB_BOOTSTRAP=0 JB_CURRICULUM=0 JB_BEHAVIOR_SEED=0
export JB_BEHAVIORS_PATH="$_jb_ops_root/ops/data/shared50/selected.csv"
export JB_COMMON_BEHAVIOR_SHA256=1787d4db623a90d1374fdfb8415ff577d55b909bca89f165924aec0008205df5
# The sampling step already chose exactly 50; eval must consume that frozen order.
export JB_N_BEHAVIORS_PER_EVAL=50 JB_FULL_BEHAVIORS=1 JB_STRATIFIED=0
export LLMGE_EVOLUTION_SEED=0
export JB_TARGET_MAX_NEW_TOKENS=512 JB_TARGET_TEMPERATURE=0.0
export JB_JUDGE_TEMPERATURE=0.1 JB_MUTATOR_MAX_NEW_TOKENS=850
export JB_VERIFY_THRESHOLD=0.5 JB_AUDIT_SAMPLE_SIZE=3
export JB_REQUEST_TIMEOUT=120 JB_MAX_CONCURRENCY=16 JB_SERVER_READY_TIMEOUT=1200
export JB_TARGET_MAX_MODEL_LEN=4096 JB_RUN_JUDGE_MAX_LEN=4096
# Immutable auxiliary revisions are recorded in auxiliary-models.json.
# stage_auxiliary.py writes auxiliary.env only after hash verification.
if [[ -f "$_jb_ops_root/ops/auxiliary.env" ]]; then
    source "$_jb_ops_root/ops/auxiliary.env"
fi
export JB_RUN_JUDGE_MODEL="${JB_RUN_JUDGE_MODEL:-$JB_SHARED_MODEL_ROOT/meta-llama/Llama-3.1-8B-Instruct}"
export JB_RUN_MUTATOR_MODEL="${JB_RUN_MUTATOR_MODEL:-$JB_RUN_JUDGE_MODEL}"
export JB_RUN_REPORTING_MODEL="${JB_RUN_REPORTING_MODEL:-$JB_SHARED_MODEL_ROOT/cais/HarmBench-Llama-2-13b-cls}"
unset _jb_ops_root
